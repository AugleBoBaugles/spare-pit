# ─── Supabase database credentials ───────────────────────────────────────────
# Copy this file to server/.env and fill in your values.
# Never commit server/.env — it contains secrets.
#
# DATABASE_URL — Transaction Pooler connection string
#   Where to find it:
#     Supabase dashboard → your project → Settings → Database
#     → "Connection string" section → select "Transaction pooler" tab
#   Looks like:
#     postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-1-<region>.pooler.supabase.com:6543/postgres
#
#   The Transaction Pooler is recommended for server-side use because it handles
#   connection management efficiently and works well with serverless / long-lived processes.

DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-1-us-west-2.pooler.supabase.com:6543/postgres
