# Copy this file to server/.env and fill in your values.
# Never commit server/.env — it contains secrets.
# Full guide: docs/DEVELOPER.md → "Choosing a Database"

# ─── Database backend ────────────────────────────────────────────────────────
# DB_CLIENT — which database to use: sqlite or postgres
#   sqlite   → a local file on this machine. No setup, no internet required.
#   postgres → any PostgreSQL server: Supabase, self-hosted, Docker, etc.
#   If unset: postgres when DATABASE_URL is set, otherwise sqlite.

DB_CLIENT=sqlite

# ─── SQLite (DB_CLIENT=sqlite) ───────────────────────────────────────────────
# SQLITE_PATH — where the database file lives, relative to the server/ folder.
#   Optional; defaults to db/frc-inventory.db. Back up this file to back up your data.

# SQLITE_PATH=db/frc-inventory.db

# ─── Postgres (DB_CLIENT=postgres) ───────────────────────────────────────────
# DATABASE_URL — Postgres connection string.
#   Self-hosted / Docker example:
#     postgresql://spare_pit:your-password@localhost:5432/spare_pit
#   Supabase: dashboard → your project → Settings → Database → "Connection string"
#     → "Transaction pooler" tab. Looks like:
#     postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-1-<region>.pooler.supabase.com:6543/postgres
#
# The inventory table is created automatically on first start if it doesn't exist.

# DATABASE_URL=postgresql://spare_pit:your-password@localhost:5432/spare_pit

# DATABASE_SSL — true or false. Optional.
#   Defaults to off for localhost and on for everything else (Supabase requires SSL).
#   Set to true if your self-hosted server is on another machine and requires SSL,
#   or false if it's on another machine and doesn't support SSL.

# DATABASE_SSL=false

# ─── CORS ─────────────────────────────────────────────────────────────────────
# CORS_ORIGIN — the URL of the frontend (no trailing slash).
#   Defaults to http://localhost:5173 when unset (local dev).
#   In production, set this to wherever the frontend is hosted, e.g.:
#     https://your-app.netlify.app

# CORS_ORIGIN=https://your-app.netlify.app
